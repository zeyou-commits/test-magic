-      ctx.beginPath();
-      ctx.moveTo(side * 9, 42);
-      ctx.quadraticCurveTo(side * 15, 62, side * 24, 96);
-      ctx.stroke();
-    });
-    // Vaguelettes d'écume qui glissent vers l'arrière et se dissolvent.
-    for (let i = 0; i < 3; i++) {
-      const t = (i / 3 + phase) % 1;
-      const y = 46 + t * 50;
-      const spread = 8 + t * 15;
-      const alpha = 0.9 * (1 - t);
-      ctx.fillStyle = `rgba(255,255,255,${alpha.toFixed(2)})`;
