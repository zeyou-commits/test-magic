+  transform: translateY(-2px);
+}
+.bw-data-note {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  color: #5d6b78;
+  font-size: 11px;
+  margin-top: 20px;
+}
+.bw-vessel-art {
+  position: relative;
+}
+.bw-vessel-art > svg {
+  width: 100%;
+  border-radius: 50% 50% 16px 16px;
+}
+.bw-art-stamp {
+  position: absolute;
+  top: 0;
+  right: 5px;
+  border-radius: 50%;
+  width: 112px;
+  height: 112px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  background: #0e7a43;
+  color: #fff;
+  font-size: 10px;
+  letter-spacing: 0.1em;
+  transform: rotate(10deg);
+  outline: 1px dashed #ffffff80;
+  outline-offset: -8px;
+}
+.bw-art-stamp strong {
+  font-size: 19px;
+  letter-spacing: -0.02em;
+  margin-block: 3px;
+}
+.bw-art-stamp > span {
+  font-size: 8px;
+}
+.bw-illustration-label {
+  display: block;
+  text-align: right;
+  font-size: 10px;
+  color: #5d6b78;
+  margin-top: 12px;
+}
+.bw-guides-section {
+  padding-block: 88px;
+}
+.bw-guide-grid {
+  display: grid;
+  grid-template-columns: 1.2fr 1fr;
+  gap: 24px;
+}
+.bw-guide-feature {
+  display: grid;
+  grid-template-columns: 1fr;
+  overflow: hidden;
+  border-radius: 18px;
+  background: #fffcf7;
+  border: 1px solid #e5e0d5;
+}
+.bw-guide-feature > svg {
+  width: 100%;
+  max-height: 280px;
+  object-fit: cover;
+}
+.bw-guide-feature > div {
+  padding: 28px 32px;
+}
+.bw-guide-feature h3 {
+  font-size: 28px;
+  line-height: 1.2;
+  font-weight: 650;
+}
+.bw-guide-feature p {
+  color: #5d6b78;
+  margin-block: 12px 16px;
+  line-height: 1.7;
+  max-width: 45ch;
+}
+.bw-guide-side {
+  display: flex;
+  flex-direction: column;
+  gap: 24px;
+}
+.bw-guide-small {
+  display: block;
+  flex: 1;
+  position: relative;
+  padding: 32px;
+  border-radius: 16px;
+  border: 1px solid #d9dfd1;
+  background: #e9eee1;
+}
+.bw-guide-icon {
+  display: block;
+  margin-bottom: 24px;
+  color: #42624c;
+}
+.bw-guide-small h3 {
+  font-size: 25px;
+  font-weight: 650;
+  margin-bottom: 12px;
+}
+.bw-guide-small p {
+  color: #53636b;
+  line-height: 1.7;
+  margin-bottom: 12px;
+  max-width: 44ch;
+}
+.bw-guide-tools {
+  background: #f0e4ce;
+  border-color: #e3d6be;
+}
+.bw-guide-feature,
+.bw-guide-small {
