-  const { data: positions = [] } = useQuery(vesselPositionsQuery);
-  const { data: vessels = [] } = useQuery(vesselsQuery);
-  const { data: departures = [] } = useQuery(fleetDeparturesQuery);
-  const { data: routes = [] } = useQuery(routesQuery);
