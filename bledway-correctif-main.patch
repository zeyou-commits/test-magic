-      const { error } = await context.supabase
-        .from("user_roles")
-        .delete()
-        .eq("user_id", data.userId)
-        .eq("role", data.role);
-      if (error) throw new Error(error.message);
-    }
-    return { ok: true };
-  });
-
-export const inviteMember = createServerFn({ method: "POST" })
